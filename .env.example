DATABASE_URL=postgres://leren:leren@localhost:54329/leren
VECTOR_STORE_URL=http://localhost:16333
RABBITMQ_URL=amqp://leren:leren@localhost:56720

# The embedding model of the knowledge index (decisions 0024 and 0027). The value is a key of
# `embeddingModels` in harness.config.ts. Changing the model or its dimensions needs a new vector
# collection.
EMBEDDING_MODEL=openrouter-embedding-small
EMBEDDING_API_KEY=
KNOWLEDGE_DRIFT_INTERVAL_MINUTES=10

# Authentication. BETTER_AUTH_SECRET must be at least 32 characters. Generate one with
# `openssl rand -base64 32`. The development SMTP server is Mailpit, whose inbox is at
# http://localhost:58025.
BETTER_AUTH_SECRET=
API_URL=http://localhost:3000
PLATFORM_URL=http://localhost:5173
SMTP_URL=smtp://localhost:51025
EMAIL_FROM=Leren <no-reply@leren.local>

# Tracing is disabled unless the Lens connection below is complete.
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=
ANVIA_LENS_SERVICE_NAME=leren
ANVIA_LENS_MEDIA_UPLOAD_ENABLED=false
ANVIA_LENS_ENVIRONMENT=development

# The model each task runs on. Each value is a key of `models` in harness.config.ts, and an empty
# value selects `defaultModel`. ASSISTANT_MODEL is read by the API and REPLY_MODEL by the worker.
# The key of the chosen model is read from the variable that its entry names in `apiKeyEnv`
# (decision 0025).
ASSISTANT_MODEL=deepseek-v4-flash-gateway
REPLY_MODEL=deepseek-v4-flash-gateway
DEEPSEEK_API_KEY=
DEVSCALE_GATEWAY_API_KEY=sk-ejt1mHAZ4Qp9uj9JgsDnyQ

# Used by the agent runners (pnpm runner:assistant, pnpm runner:reply).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API=
MCP_URL=
MCP_TOKEN=
