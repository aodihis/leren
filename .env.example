DATABASE_URL=postgres://leren:leren@localhost:54329/leren
VECTOR_STORE_URL=http://localhost:16333
RABBITMQ_URL=amqp://leren:leren@localhost:56720
# Holds the rate-limit counters of the MCP endpoint (decision 0053). It may also hold caches later.
REDIS_URL=redis://localhost:56379

# The roles that a worker process runs, separated by commas: listener (reads mailboxes), processor
# (the gate, the reply pipeline and the deliverer) and indexer (the knowledge index). Empty runs
# every role. A variable that only one role uses is required only when that role starts (decision
# 0045). A process with only the processor role stops at startup if the reply pipeline cannot be
# built.
WORKER_ROLES=

# The embedding model of the knowledge index (decisions 0024 and 0027). The value is a key of
# `embeddingModels` in harness.config.ts. Changing the model or its dimensions needs a new vector
# collection.
EMBEDDING_MODEL=openrouter-embedding-small
EMBEDDING_API_KEY=
KNOWLEDGE_DRIFT_INTERVAL_MINUTES=10

# How often the worker reads the mailbox of every connected email account (decision 0041).
EMAIL_POLL_INTERVAL_SECONDS=60

# Authentication. BETTER_AUTH_SECRET must be at least 32 characters. Generate one with
# `openssl rand -base64 32`. The development SMTP server is Mailpit, whose inbox is at
# http://localhost:58025.
BETTER_AUTH_SECRET=
API_URL=http://localhost:3000
PLATFORM_URL=http://localhost:5173
SMTP_URL=smtp://localhost:51025

# Signs the session tokens of the MCP server (decision 0031). At least 32 characters. Generate one
# with `openssl rand -base64 32`. The worker needs the same value to run the reply pipeline, and it
# reaches the MCP server at MCP_URL.
MCP_SESSION_SECRET=
EMAIL_FROM=Leren <no-reply@leren.local>

# Tracing is disabled unless the Lens connection below is complete.
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=
ANVIA_LENS_SERVICE_NAME=leren
ANVIA_LENS_MEDIA_UPLOAD_ENABLED=false
ANVIA_LENS_ENVIRONMENT=development

# The model each task runs on. Each value is a key of `models` in harness.config.ts, and an empty
# value selects `defaultModel`. ASSISTANT_MODEL is read by the API and REPLY_MODEL by the worker.
# The key of the chosen model is read from the variable that its entry names in `apiKeyEnv`
# (decision 0025).
ASSISTANT_MODEL=deepseek-v4-flash-gateway
REPLY_MODEL=deepseek-v4-flash-gateway
# The reply pipeline's triage and judge steps. An empty value selects the model of REPLY_MODEL.
# The judge should be a different model from REPLY_MODEL (decision 0042).
REPLY_TRIAGE_MODEL=
REPLY_JUDGE_MODEL=
DEEPSEEK_API_KEY=
DEVSCALE_GATEWAY_API_KEY=

# Used by the agent runners (pnpm runner:assistant, pnpm runner:reply).
OPENAI_API_KEY=
# The runners connect to the MCP server only when both values are set. MCP_TOKEN is an access
# token. Sign in to the platform and create one on the Agent access page.
MCP_URL=http://localhost:3000/mcp
MCP_TOKEN=

# The channel providers that users can connect, separated by commas (decision 0038). Known names are
# google and mailpit. Empty enables none. mailpit is for development and tests only, and the API
# refuses to start with it when NODE_ENV is production. An enabled provider needs its own settings.
# The API and the worker read these variables, so both need them.
CHANNEL_PROVIDERS=mailpit
# Encrypts the stored tokens of connected accounts. Required when google is enabled. 32 random bytes
# encoded as base64. Generate one with `openssl rand -base64 32`.
CHANNEL_TOKEN_ENCRYPTION_KEY=
# The OAuth client of the google provider. The authorized redirect URI is
# ${API_URL}/api/channel-accounts/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The connectors that users can link so the assistant can read their data (decision 0054), separated
# by commas. Available values:
#   notion         needs nothing besides CHANNEL_TOKEN_ENCRYPTION_KEY, because it registers its own
#                  OAuth client
#   google_docs    needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
#   google_sheets  needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# Empty enables none. For example: CONNECTORS=notion,google_sheets. An enabled connector needs
# CHANNEL_TOKEN_ENCRYPTION_KEY. Only the API reads this variable. The redirect URI of a connector is
# ${API_URL}/api/connectors/<connector>/callback.
CONNECTORS=
