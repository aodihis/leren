{
  "name": "leren",
  "version": "0.0.0",
  "private": true,
  "description": "Leren monorepo",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "runner:assistant": "pnpm --filter @leren/assistant-agent runner:run",
    "runner:reply": "pnpm --filter @leren/reply-agent runner:run",
    "test:lint-rules": "node tooling/oxlint/run-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.94.0",
    "@vitest/coverage-v8": "^5.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0"
}
