{
  "name": "leren",
  "version": "0.0.0",
  "private": true,
  "description": "Leren monorepo",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:app": "node tooling/build/build.mjs",
    "demo": "tsx --env-file-if-exists=.env tooling/demo/demo.ts",
    "evals": "pnpm --filter @leren/assistant-agent evals",
    "evals:secure": "dotenvx run -f .env -- pnpm evals",
    "evals:reply": "pnpm --filter @leren/reply-agent evals",
    "runner:assistant": "pnpm --filter @leren/assistant-agent runner:run",
    "runner:reply": "pnpm --filter @leren/reply-agent runner:run",
    "studio:assistant": "dotenvx run -f .env -- pnpm --filter @leren/assistant-agent studio",
    "api:dev:secure": "dotenvx run -f .env -- pnpm --filter @leren/api dev",
    "api:start:secure": "dotenvx run -f .env -- pnpm --filter @leren/api start",
    "platform:dev:secure": "dotenvx run -f .env -- pnpm --filter @leren/platform dev",
    "worker:dev:secure": "dotenvx run -f .env -- pnpm --filter @leren/worker dev",
    "worker:start:secure": "dotenvx run -f .env -- pnpm --filter @leren/worker start",
    "runner:assistant:secure": "dotenvx run -f .env -- pnpm runner:assistant",
    "runner:reply:secure": "dotenvx run -f .env -- pnpm runner:reply",
    "env:encrypt": "dotenvx encrypt -f .env",
    "test:lint-rules": "node tooling/oxlint/run-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "services:up": "podman compose -f docker-compose.dev.yml up -d",
    "services:down": "podman compose -f docker-compose.dev.yml down",
    "test:e2e": "pnpm --filter @leren/e2e test",
    "db:migrate": "pnpm --filter @leren/db db:migrate",
    "db:generate": "pnpm --filter @leren/db db:generate"
  },
  "devDependencies": {
    "@anvia/core": "^1.21.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@leren/agents": "workspace:*",
    "@leren/plugin-client": "workspace:*",
    "@oxlint/plugins": "^1.94.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0"
}
