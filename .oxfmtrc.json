{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "tooling/oxlint/vendor/**",
    "docs/design-system/**",
    "packages/ui/src/components/ui/**",
    "packages/ui/src/hooks/**",
    "packages/ui/src/lib/utils.ts",
    "packages/ui/src/styles/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "pnpm-lock.yaml"
  ]
}
