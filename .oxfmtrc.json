{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "tooling/oxlint/vendor/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "pnpm-lock.yaml"
  ]
}
